# Copy to .env and fill in as you connect real providers.
# Any category without credentials falls back to the built-in mock provider,
# so the app is fully usable with every value left blank.

PORT=8787

# Required when the app is on the internet (e.g. trips.jascui.com); leave
# blank on your own Mac to skip the login screen.
APP_PASSWORD=
# Optional: any long random string. Defaults to one derived from APP_PASSWORD.
SESSION_SECRET=
# Hosted only: protects the daily price-check endpoint (Vercel Cron sends it).
CRON_SECRET=
# Time zone for "today" in price watch, e.g. America/Los_Angeles.
APP_TIMEZONE=

# Maps & driving times. Without a key, routes come from OpenStreetMap (OSRM),
# which is free. Set MAPS_OFFLINE=1 to use straight-line estimates only.
GOOGLE_MAPS_API_KEY=
MAPS_OFFLINE=

# Price watch: how often (minutes) to look for watches not yet checked today.
WATCH_INTERVAL_MINUTES=60

# Real flight + hotel prices — https://serpapi.com (free tier: a few hundred searches/month)
# Flights come from Google Flights; hotels from Google Hotels, including the
# per-site prices Google shows (Hotels.com, Expedia, Booking.com, the hotel's own site…).
SERPAPI_API_KEY=

# Flights (bookable fares, future) — https://duffel.com
DUFFEL_API_KEY=

# Hotels (bookable rates, future) — https://www.booking.com/affiliate-program
BOOKING_AFFILIATE_ID=

# Activities — https://partner.getyourguide.com
GETYOURGUIDE_API_KEY=

# Car rentals
RENTALCARS_API_KEY=

# Dining — https://docs.developer.yelp.com
YELP_API_KEY=
