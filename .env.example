# Copy to .env and fill in as you connect real providers.
# A search category without a connected provider shows no results (never
# made-up ones), only links to run the same search on real sites.

PORT=8787

# Required when the app is on the internet (e.g. trips.jascui.com); leave
# blank on your own Mac to skip the login screen.
APP_PASSWORD=
# Optional: any long random string. Defaults to one derived from APP_PASSWORD.
SESSION_SECRET=
# Time zone for "today" in price watch, e.g. America/Los_Angeles.
APP_TIMEZONE=

# Maps & driving times. Without a key, routes come from OpenStreetMap (OSRM),
# which is free. Set MAPS_OFFLINE=1 to use straight-line estimates only.
GOOGLE_MAPS_API_KEY=
MAPS_OFFLINE=

# Flights: Google Flights via SerpApi — https://serpapi.com (free plan: 250 searches/month).
# SerpApi is used for flights only.
SERPAPI_API_KEY=

# Stays: Hotels.com via the Hotels.com Provider API on RapidAPI (free Basic plan) —
# https://rapidapi.com/tipsters/api/hotels-com-provider. Subscribe, then paste your X-RapidAPI-Key.
RAPIDAPI_KEY=

# Export to the travel budget at jascui.com/travel_budget. The login is optional
# here: leave it blank and type it in the Export dialog instead.
TRAVEL_BUDGET_URL=https://www.jascui.com
TRAVEL_BUDGET_USERNAME=
TRAVEL_BUDGET_PASSWORD=
